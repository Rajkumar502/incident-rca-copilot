# Copy this file to .env and fill in whatever you have — every value is
# optional. The project runs fully offline (mock LLM, mock Jira write-back,
# TF-IDF retrieval) with none of these set. Each one you add unlocks exactly
# one real integration. See src/config.py and README.md "Configuration".

GEMINI_API_KEY=

JIRA_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

GITHUB_TOKEN=

GRAFANA_URL=
GRAFANA_API_KEY=

SPLUNK_URL=
SPLUNK_TOKEN=

VECTOR_STORE=tfidf
COST_CEILING_USD=0.25

# Automatic trigger (src/webhook/server.py) — all optional
WEBHOOK_SECRET=
WEBHOOK_TRIGGER_LABEL=incident
WEBHOOK_SERVICE_FIELD=
WEBHOOK_GITHUB_OWNER=
WEBHOOK_GITHUB_REPO=

# Retry/backoff for transient tool failures (src/governance/retry.py)
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_SECONDS=0.5
